# Build artifacts (can be multiple GB) — never needed inside the image
/target

# Git metadata
/.git
.gitignore

# Docs and CI not needed to build the binary
*.md
/.github
# The browser demo is a static site, not part of any node image
/docs

# Deployment manifests (handled outside the image build)
/helm

# Editor/OS cruft
**/*.rs.bk
*.swp
*.swo
.DS_Store
